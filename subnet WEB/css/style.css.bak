/* ==========================================================================
   ✦ SMART KURDS PLUS - CORE CSS DESIGN TOKENS & SUBNET SUITE THEME ✦
   100% matched with Smart Kurds Plus specifications, RTL Kurdish typography,
   Canvas Parallax, Settings Drawer, Themes, and Interactive Subnetting.
   ========================================================================== */

:root {
    /* Preset Kurdish & English Font Stacks */
    --font-vazirmatn: 'Vazirmatn', -apple-system, sans-serif;
    --font-noto-sans: 'Noto Sans Arabic', sans-serif;
    --font-noto-kufi: 'Noto Kufi Arabic', sans-serif;
    --font-inter: 'Inter', -apple-system, sans-serif;
    --font-outfit: 'Outfit', sans-serif;
    --font-jakarta: 'Plus Jakarta Sans', sans-serif;
    --font-mono: 'JetBrains Mono', 'Consolas', monospace;

    /* Active Typography (Default: Noto Kufi) */
    --active-font: var(--font-noto-kufi);
    --base-font-size: 100%;

    /* Core Dark Tech Palette */
    --bg-primary: #07090e;
    --bg-secondary: #0d111a;
    --bg-card: rgba(15, 22, 35, 0.78);
    --bg-card-hover: rgba(22, 32, 52, 0.88);
    --bg-glass: rgba(255, 255, 255, 0.03);
    
    /* Dynamic Accent Color (Default: Electric Blue) */
    --accent-cyan: #3a86ff;
    --accent-purple: #7b2cbf;
    --accent-neon: #3a86ff;
    --accent-gold: #ffb703;
    --accent-pink: #ff007f;
    --accent-emerald: #10b981;
    --accent-rose: #f43f5e;
    
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --text-dim: #475569;
    
    --border-color: rgba(255, 255, 255, 0.08);
    --border-glow: rgba(58, 134, 255, 0.28);
    
    --radius-xs: 6px;
    --radius-sm: 10px;
    --radius-md: 16px;
    --radius-lg: 24px;
    --radius-full: 9999px;
    
    --shadow-subtle: 0 10px 30px rgba(0, 0, 0, 0.5);
    --shadow-glow: 0 0 25px rgba(58, 134, 255, 0.25);
    --shadow-card: 0 12px 35px -6px rgba(0, 0, 0, 0.6), 0 0 1px 1px rgba(255, 255, 255, 0.05);
    
    --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Preset Background Themes */
[data-theme="dark"] {
    --bg-primary: #07090e;
    --bg-secondary: #0d111a;
    --bg-card: rgba(15, 22, 35, 0.78);
    --bg-card-hover: rgba(22, 32, 52, 0.88);
}

[data-theme="cyber"] {
    --bg-primary: #05050a;
    --bg-secondary: #0a0a14;
    --bg-card: rgba(18, 12, 28, 0.82);
    --bg-card-hover: rgba(28, 18, 44, 0.9);
}

[data-theme="emerald"] {
    --bg-primary: #03120e;
    --bg-secondary: #072019;
    --bg-card: rgba(10, 28, 22, 0.82);
    --bg-card-hover: rgba(16, 42, 33, 0.9);
}

[data-theme="sapphire"] {
    --bg-primary: #040d1a;
    --bg-secondary: #08162b;
    --bg-card: rgba(12, 28, 50, 0.82);
    --bg-card-hover: rgba(18, 40, 72, 0.9);
}

[data-theme="amethyst"] {
    --bg-primary: #0d0617;
    --bg-secondary: #160c24;
    --bg-card: rgba(26, 15, 43, 0.82);
    --bg-card-hover: rgba(38, 22, 64, 0.9);
}

/* Base Reset */
*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
}

html {
    scroll-behavior: smooth;
    font-size: var(--base-font-size);
    background-color: var(--bg-primary);
    transition: background-color var(--transition);
}

body,
button,
input,
select,
textarea,
optgroup {
    font-family: var(--active-font), 'Noto Kufi Arabic', 'Vazirmatn', sans-serif;
}

body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    line-height: 1.7;
    transition: opacity 0.22s ease-in-out;
}

body.lang-english {
    font-family: var(--font-inter), sans-serif;
}

/* FontAwesome Helper */
.fa, .fas, .far, .fab, .fa-solid, .fa-regular, .fa-brands {
    font-family: "Font Awesome 6 Free", "Font Awesome 6 Brands" !important;
}

/* Dynamic Background Canvas (SK+ Parallax) */
#bgCanvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
    display: block;
}

/* Content Stacking Above Canvas */
.app-header,
.main-content,
.settings-drawer,
.settings-overlay {
    position: relative;
    z-index: 1;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}
::-webkit-scrollbar-track {
    background: var(--bg-primary);
}
::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-full);
}
::-webkit-scrollbar-thumb:hover {
    background: var(--accent-cyan);
}

/* ==========================================================================
   Header Navigation (Smart Kurds Plus Official Design)
   ========================================================================== */
.app-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: rgba(7, 9, 14, 0.88);
    border-bottom: 1px solid var(--border-color);
    padding: 0.85rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: var(--transition);
}

.brand-logo {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: var(--text-primary);
    cursor: pointer;
    transition: var(--transition);
}

.brand-logo:hover {
    transform: translateY(-2px);
    opacity: 0.95;
}

.logo-icon {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0;
    transition: var(--transition);
}

.logo-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 0 10px var(--accent-cyan)) drop-shadow(0 0 18px rgba(58, 134, 255, 0.4));
    transition: var(--transition);
}

.brand-text h1 {
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    background: linear-gradient(90deg, #ffffff, #94a3b8);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.2;
}

.brand-text span {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--accent-cyan);
    letter-spacing: 0.05em;
    display: block;
}

/* Primary Navigation Links (Segmented) */
.nav-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    list-style: none;
    background: rgba(15, 22, 35, 0.6);
    border: 1px solid var(--border-color);
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-md);
}

.nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 700;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    cursor: pointer;
    background: transparent;
}

.nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.06);
}

.nav-link.active {
    color: #ffffff;
    background: linear-gradient(135deg, rgba(58, 134, 255, 0.3), rgba(0, 245, 212, 0.15));
    border-color: var(--accent-cyan);
    box-shadow: 0 0 16px rgba(58, 134, 255, 0.35);
}

/* Nav Actions (Buttons on right/left) */
.nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.btn-theme {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
    font-size: 1.1rem;
    overflow: hidden;
    white-space: nowrap;
    flex-shrink: 0;
}

.btn-theme:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    transform: scale(1.05);
    box-shadow: 0 0 15px rgba(58, 134, 255, 0.25);
}

.btn-cta {
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-neon));
    color: #05070c;
    font-weight: 800;
    font-size: 0.88rem;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-sm);
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: var(--transition);
    box-shadow: 0 4px 15px rgba(58, 134, 255, 0.3);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: inherit;
}

.btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(58, 134, 255, 0.5);
}

/* Student XP Badge in Nav */
.student-xp-pill {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(15, 22, 35, 0.85);
    border: 1px solid var(--border-color);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-full);
    font-size: 0.84rem;
}

.student-xp-pill .xp-val {
    color: var(--accent-gold);
    font-weight: 800;
    font-family: var(--font-mono);
}

/* ==========================================================================
   Floating Settings Button & Drawer (Smart Kurds Plus Signature)
   ========================================================================== */
.floating-settings-btn {
    position: fixed;
    bottom: 25px;
    z-index: 1400;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-glow);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5), var(--shadow-glow);
    transition: var(--transition);
    font-size: 1.25rem;
}
html[dir="rtl"] .floating-settings-btn {
    left: 25px;
    right: auto;
}
html[dir="ltr"] .floating-settings-btn {
    right: 25px;
    left: auto;
}
.floating-settings-btn:hover {
    transform: rotate(60deg) scale(1.1);
    background: var(--accent-cyan);
    color: #000;
}

/* Settings Overlay & Drawer */
.settings-overlay {
    position: fixed;
    inset: 0;
    background: rgba(4, 6, 10, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 2500;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
}
.settings-overlay.open {
    opacity: 1;
    pointer-events: auto;
}

.settings-drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    width: 390px;
    max-width: 90vw;
    background: rgba(13, 17, 26, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-left: 1px solid var(--border-color);
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.7);
    z-index: 2600;
    display: flex;
    flex-direction: column;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
html[dir="rtl"] .settings-drawer {
    left: 0;
    right: auto;
    border-left: none;
    border-right: 1px solid var(--border-color);
    transform: translateX(-100%);
}
html[dir="ltr"] .settings-drawer {
    right: 0;
    left: auto;
    transform: translateX(100%);
}
.settings-drawer.open {
    transform: translateX(0);
}

.settings-drawer-header {
    padding: 1.4rem 1.6rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.settings-drawer-title {
    display: flex;
    align-items: center;
    gap: 0.8rem;
}

.settings-title-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: rgba(58, 134, 255, 0.15);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
}

.settings-drawer-title h3 {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-primary);
}

.settings-subtitle {
    font-size: 0.76rem;
    color: var(--text-muted);
}

.settings-close-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 1.8rem;
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s;
}
.settings-close-btn:hover {
    color: var(--accent-cyan);
}

.settings-drawer-body {
    padding: 1.6rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
}

.settings-group-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-secondary);
    margin-bottom: 0.8rem;
}
.settings-group-label i {
    color: var(--accent-cyan);
}

/* Language Cards in Drawer */
.lang-switch-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
}

.lang-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 0.85rem;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    cursor: pointer;
    transition: var(--transition);
    text-align: right;
    color: var(--text-primary);
}
html[dir="ltr"] .lang-card {
    text-align: left;
}
.lang-card:hover {
    border-color: var(--accent-cyan);
    background: var(--bg-card-hover);
}
.lang-card.active {
    border-color: var(--accent-cyan);
    background: rgba(58, 134, 255, 0.15);
    box-shadow: 0 0 15px rgba(58, 134, 255, 0.2);
}

/* Font Cards */
.font-switch-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
}

.font-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 0.7rem 1rem;
    border-radius: var(--radius-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    color: var(--text-primary);
    transition: var(--transition);
}
.font-card:hover {
    border-color: var(--accent-cyan);
    background: var(--bg-card-hover);
}
.font-card.active {
    border-color: var(--accent-cyan);
    background: rgba(58, 134, 255, 0.15);
    color: var(--accent-cyan);
}

/* Font Size Buttons */
.size-switch-group {
    display: flex;
    gap: 0.5rem;
}
.size-btn {
    flex: 1;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-weight: 700;
    transition: var(--transition);
}
.size-btn:hover {
    color: var(--text-primary);
    border-color: var(--accent-cyan);
}
.size-btn.active {
    background: var(--accent-cyan);
    color: #000;
    border-color: var(--accent-cyan);
}

/* Accent Palette Grid */
.accent-palette-grid {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
}

.color-swatch {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--c);
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
}
.color-swatch:hover {
    transform: scale(1.15);
}
.color-swatch.active {
    border-color: #ffffff;
    box-shadow: 0 0 16px var(--c);
    transform: scale(1.12);
}

/* Theme Switch Grid */
.theme-switch-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.7rem;
}

.theme-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 0.7rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 700;
    transition: var(--transition);
}
.theme-card:hover {
    border-color: var(--accent-cyan);
    color: var(--text-primary);
}
.theme-card.active {
    border-color: var(--accent-cyan);
    background: rgba(58, 134, 255, 0.15);
    color: var(--text-primary);
}

.theme-preview {
    width: 16px;
    height: 16px;
    border-radius: 50%;
}
.dark-preview { background: #07090e; border: 1px solid #334155; }
.cyber-preview { background: #0a0a14; border: 1px solid #7b2cbf; }
.emerald-preview { background: #03120e; border: 1px solid #10b981; }
.sapphire-preview { background: #040d1a; border: 1px solid #3a86ff; }
.amethyst-preview { background: #0d0617; border: 1px solid #ff007f; }

/* Reset Settings Button */
.btn-reset-settings {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #fca5a5;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-weight: 700;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}
.btn-reset-settings:hover {
    background: #ef4444;
    color: #fff;
}

/* ==========================================================================
   ✦ HERO SECTION & LIVE STATS (SMART KURDS PLUS SIGNATURE) ✦
   ========================================================================== */
.hero-section {
    padding: 5rem 2rem 3rem 2rem;
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 10;
}

.hero-badge {
    background: rgba(0, 245, 212, 0.1);
    border: 1px solid rgba(0, 245, 212, 0.3);
    color: var(--accent-cyan);
    padding: 0.45rem 1.4rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}

.hero-title {
    font-size: 3.2rem;
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
    max-width: 960px;
    background: linear-gradient(180deg, #ffffff 40%, #94a3b8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-title span {
    background: linear-gradient(90deg, var(--accent-cyan), var(--accent-neon), var(--accent-purple));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-subtitle {
    font-size: 1.12rem;
    color: var(--text-secondary);
    max-width: 820px;
    line-height: 1.85;
    margin-bottom: 2.2rem;
}

.hero-buttons {
    display: flex;
    gap: 1.1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 3.5rem;
}

.btn-outline {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.75rem 1.6rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    text-decoration: none;
    font-family: inherit;
}

.btn-outline:hover {
    border-color: var(--accent-cyan);
    background: rgba(0, 245, 212, 0.08);
    transform: translateY(-2px);
    color: var(--accent-cyan);
    box-shadow: 0 0 15px rgba(58, 134, 255, 0.2);
}

.stats-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    width: 100%;
    max-width: 1100px;
    margin-bottom: 1.5rem;
}

.stat-card {
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.6rem;
    text-align: center;
    transition: var(--transition);
    box-shadow: var(--shadow-card);
}

.stat-card:hover {
    border-color: var(--border-glow);
    box-shadow: var(--shadow-glow);
    transform: translateY(-4px);
}

.stat-number {
    font-size: 2.3rem;
    font-weight: 900;
    color: var(--accent-cyan);
    margin-bottom: 0.3rem;
    font-family: 'Inter', var(--active-font), sans-serif;
    direction: ltr;
    display: inline-block;
}

.stat-label {
    font-size: 0.92rem;
    color: var(--text-secondary);
    font-weight: 600;
}

.section-tag {
    color: var(--accent-cyan);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    display: block;
}

.section-title {
    font-size: 2.1rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    background: linear-gradient(180deg, #ffffff 40%, #94a3b8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* ==========================================================================
   Main App Content & Subnet Views
   ========================================================================== */
.main-content {
    max-width: 1300px;
    margin: 1.5rem auto 5rem;
    padding: 0 1.8rem;
    position: relative;
    z-index: 10;
}

.app-view {
    display: none;
    animation: fadeInView 0.35s ease-out forwards;
}
.app-view.active {
    display: block;
}

@keyframes fadeInView {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Sub-Mode Selector Cards */
.submode-selector {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
}

.game-submode-btn {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 1.2rem;
    border-radius: var(--radius-md);
    color: var(--text-muted);
    cursor: pointer;
    text-align: right;
    transition: var(--transition);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(14px);
    position: relative;
    overflow: hidden;
}
html[dir="ltr"] .game-submode-btn {
    text-align: left;
}

.game-submode-btn:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent-cyan);
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4), var(--shadow-glow);
}

.game-submode-btn.active {
    background: linear-gradient(135deg, rgba(58, 134, 255, 0.18), rgba(0, 245, 212, 0.12));
    border-color: var(--accent-cyan);
    color: var(--text-primary);
    box-shadow: 0 8px 25px rgba(58, 134, 255, 0.28);
}

.game-submode-btn.active::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-cyan), var(--accent-purple));
}

.game-submode-btn .submode-title {
    font-size: 1.1rem;
    font-weight: 800;
    display: block;
    margin-bottom: 0.35rem;
    color: var(--text-primary);
}

.game-submode-btn .submode-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
}

.game-panel {
    display: none;
    animation: fadeInView 0.3s ease-out forwards;
}
.game-panel.active {
    display: block;
}

/* Cyber Cards (Smart Kurds Plus Glassmorphism) */
.cyber-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.2rem;
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
}

.cyber-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-cyan), var(--accent-purple), transparent);
}

.card-title {
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-primary);
}

.card-subtitle {
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
}

/* Buttons */
.cyber-btn {
    background: rgba(22, 32, 52, 0.85);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.7rem 1.5rem;
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
}
.cyber-btn:hover {
    background: rgba(58, 134, 255, 0.2);
    border-color: var(--accent-cyan);
    box-shadow: 0 0 16px rgba(58, 134, 255, 0.35);
    transform: translateY(-2px);
}

.cyber-btn.primary-glow {
    background: linear-gradient(135deg, var(--accent-cyan), #2563eb);
    border-color: var(--accent-cyan);
    color: #ffffff;
    box-shadow: 0 4px 18px rgba(58, 134, 255, 0.4);
}
.cyber-btn.primary-glow:hover {
    box-shadow: 0 6px 25px rgba(58, 134, 255, 0.6);
}

.cyber-btn.btn-correct {
    background: #059669 !important;
    border-color: #34d399 !important;
    color: #ffffff !important;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.6);
}
.cyber-btn.btn-wrong {
    background: #dc2626 !important;
    border-color: #f87171 !important;
    color: #ffffff !important;
    box-shadow: 0 0 20px rgba(239, 68, 68, 0.6);
}

/* Slicer Game Elements */
.slicer-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.2rem;
    background: rgba(13, 17, 26, 0.7);
    border: 1px solid var(--border-color);
    padding: 1.2rem 1.6rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.6rem;
}

.master-badge {
    background: rgba(58, 134, 255, 0.18);
    border: 1px solid var(--accent-cyan);
    color: var(--accent-cyan);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-weight: 800;
}

.slicer-timeline-bar {
    height: 52px;
    background: rgba(2, 6, 23, 0.85);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    display: flex;
    overflow: hidden;
    margin: 1rem 0;
    box-shadow: inset 0 3px 10px rgba(0,0,0,0.7);
}

.slicer-timeline-chunk {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 800;
    color: #ffffff;
    text-shadow: 0 1px 4px rgba(0,0,0,0.9);
    transition: width 0.35s ease;
    border-right: 1px solid rgba(0,0,0,0.35);
}

.slicer-timeline-chunk.free-chunk {
    background: repeating-linear-gradient(
        45deg,
        rgba(30, 41, 59, 0.45),
        rgba(30, 41, 59, 0.45) 12px,
        rgba(15, 22, 35, 0.75) 12px,
        rgba(15, 22, 35, 0.75) 24px
    );
    color: var(--text-dim);
}

.slicer-dept-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.2rem;
    margin: 1.6rem 0;
}

.slicer-dept-card {
    background: rgba(13, 17, 26, 0.75);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.3rem;
    border-left-width: 5px;
    border-right-width: 5px;
    transition: var(--transition);
}
.slicer-dept-card:hover {
    background: var(--bg-card-hover);
    box-shadow: var(--shadow-subtle);
    transform: translateY(-2px);
}

.dept-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.9rem;
}

.dept-name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.98rem;
}

.dept-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: 0 0 10px currentColor;
}

.req-tag {
    font-size: 0.82rem;
    color: var(--text-secondary);
    background: rgba(255,255,255,0.06);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-xs);
    font-weight: 700;
}

.cyber-select {
    width: 100%;
    background: #090d16;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.92rem;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
}
.cyber-select:focus {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 14px var(--shadow-glow);
}

/* Speed Game Elements */
.speed-stats-bar {
    display: flex;
    justify-content: space-around;
    align-items: center;
    background: rgba(13, 17, 26, 0.7);
    border: 1px solid var(--border-color);
    padding: 1.2rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.8rem;
}

.speed-stat-box { text-align: center; }
.speed-stat-label { font-size: 0.84rem; color: var(--text-secondary); }
.speed-stat-val { font-size: 1.9rem; font-weight: 900; font-family: var(--font-mono); }

.speed-target-card {
    text-align: center;
    padding: 2.2rem 1.6rem;
    background: radial-gradient(circle at center, rgba(58, 134, 255, 0.16) 0%, rgba(13, 17, 26, 0.75) 80%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    margin-bottom: 1.8rem;
    box-shadow: 0 8px 30px rgba(0,0,0,0.4);
}

.speed-ip-display {
    font-size: 2.4rem;
    font-weight: 900;
    font-family: var(--font-mono);
    color: var(--accent-cyan);
    text-shadow: 0 0 25px var(--shadow-glow);
    margin-bottom: 0.6rem;
}

.speed-options-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
    margin-bottom: 1.8rem;
}

.speed-opt-btn {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    padding: 1.3rem;
    border-radius: var(--radius-md);
}

/* Binary Matrix Elements */
.binary-matrix-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.2rem;
    background: rgba(13, 17, 26, 0.7);
    border: 1px solid var(--border-color);
    padding: 1.2rem 1.6rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.8rem;
}

.target-cidr-display {
    font-size: 2.2rem;
    font-weight: 900;
    font-family: var(--font-mono);
    color: var(--accent-cyan);
    text-shadow: 0 0 20px var(--shadow-glow);
}

.binary-octets-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.4rem;
    margin: 1.8rem 0;
}

.binary-octet-box {
    background: rgba(13, 17, 26, 0.85);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.2rem;
    text-align: center;
}

.octet-label {
    font-size: 0.9rem;
    color: var(--accent-cyan);
    margin-bottom: 0.6rem;
    font-weight: 700;
}

.bit-weights-row {
    display: flex;
    gap: 5px;
    justify-content: center;
    margin-bottom: 0.4rem;
    direction: ltr;
}

.bit-weight-val {
    width: 32px;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--text-dim);
    text-align: center;
}

.bits-row {
    display: flex;
    gap: 5px;
    justify-content: center;
    direction: ltr;
}

.bit-cell {
    width: 32px;
    height: 48px;
    background: #07090e;
    border: 1px solid #334155;
    border-radius: var(--radius-xs);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}
.bit-cell:hover {
    transform: translateY(-2px);
    border-color: var(--accent-cyan);
}
.bit-cell.is-one {
    background: linear-gradient(180deg, var(--accent-cyan), #1d4ed8);
    border-color: var(--accent-cyan);
    color: #ffffff;
    box-shadow: 0 0 14px var(--shadow-glow);
}
.bit-cell.is-zero {
    background: rgba(30, 41, 59, 0.65);
    border-color: #475569;
    color: #94a3b8;
}

.binary-live-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.2rem;
    margin: 1.8rem 0;
}

.live-stat-card {
    background: rgba(13, 17, 26, 0.6);
    border: 1px solid var(--border-color);
    padding: 1rem;
    border-radius: var(--radius-md);
    text-align: center;
}
.live-stat-card .lbl { font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 0.2rem; }
.live-stat-card .val { font-size: 1.4rem; font-weight: 800; font-family: var(--font-mono); color: var(--accent-cyan); }

/* Exam Arena Elements */
.quiz-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.4rem;
}

.quiz-counter-badge {
    background: rgba(58, 134, 255, 0.2);
    border: 1px solid var(--accent-cyan);
    color: var(--accent-cyan);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    font-weight: 700;
}

.quiz-question-card {
    background: rgba(13, 17, 26, 0.8);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.2rem;
    margin-bottom: 1.8rem;
}

.quiz-q-text {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.7;
    color: #ffffff;
    margin-bottom: 1.8rem;
}

.quiz-options-grid {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
}

.quiz-option-btn {
    text-align: right;
    justify-content: flex-start;
    padding: 1.1rem 1.6rem;
    font-size: 1.08rem;
    background: rgba(22, 32, 52, 0.75);
    border-radius: var(--radius-md);
}
html[dir="ltr"] .quiz-option-btn {
    text-align: left;
}

.quiz-explanation-box {
    margin-top: 1.8rem;
    padding: 1.4rem 1.6rem;
    background: rgba(58, 134, 255, 0.12);
    border: 1px solid var(--accent-cyan);
    border-radius: var(--radius-md);
    color: #bae6fd;
}

/* Calculator & Binary Inspector */
.calc-inputs-bar {
    display: grid;
    grid-template-columns: 2fr 1.2fr auto;
    gap: 1.2rem;
    align-items: end;
    margin-bottom: 2.2rem;
}

.form-group label {
    display: block;
    font-size: 0.92rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
}

.cyber-input {
    width: 100%;
    background: #07090e;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 1.05rem;
    outline: none;
    transition: all 0.2s;
}
.cyber-input:focus {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 16px var(--shadow-glow);
}

.calc-summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.2rem;
    margin-bottom: 2.2rem;
}

.summary-card {
    background: rgba(13, 17, 26, 0.75);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.2rem;
    transition: var(--transition);
}
.summary-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent-cyan);
}
.summary-card .lbl { font-size: 0.84rem; color: var(--text-secondary); margin-bottom: 0.4rem; }
.summary-card .val { font-size: 1.25rem; font-family: var(--font-mono); font-weight: 800; color: var(--accent-cyan); word-break: break-all; }

/* Binary Breakdown */
.binary-display-wrapper {
    background: rgba(2, 6, 23, 0.8);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.8rem;
    margin-bottom: 2.2rem;
}

.binary-row { margin-bottom: 1.2rem; }
.binary-row-title { font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 0.5rem; font-weight: 600; }
.binary-octets-flex {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    direction: ltr;
}
.oct-block {
    background: rgba(13, 17, 26, 0.9);
    border: 1px solid rgba(255,255,255,0.12);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-xs);
    letter-spacing: 2px;
}
.oct-dot { color: var(--text-dim); font-weight: 900; }
.bit-net { color: var(--accent-cyan); font-weight: 800; }
.bit-host { color: var(--accent-gold); font-weight: 800; }

.binary-op-separator {
    position: relative;
    text-align: center;
    margin: 1.4rem 0;
}
.binary-op-separator::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--border-color);
}
.binary-op-separator span {
    position: relative;
    background: var(--bg-primary);
    padding: 0.25rem 1rem;
    font-size: 0.78rem;
    color: var(--accent-emerald);
    font-family: var(--font-mono);
    border-radius: var(--radius-full);
    border: 1px solid rgba(16, 185, 129, 0.35);
}
.oct-block.net-res {
    background: rgba(16, 185, 129, 0.18);
    border-color: var(--accent-emerald);
    color: #6ee7b7;
}

/* Subnet Table */
.table-responsive {
    overflow-x: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
}

.cyber-table {
    width: 100%;
    border-collapse: collapse;
    text-align: right;
    font-size: 0.92rem;
}
html[dir="ltr"] .cyber-table { text-align: left; }

.cyber-table th {
    background: rgba(13, 17, 26, 0.9);
    color: var(--accent-cyan);
    padding: 0.9rem 1.2rem;
    font-weight: 700;
    border-bottom: 1px solid var(--border-color);
}

.cyber-table td {
    padding: 0.85rem 1.2rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    font-family: var(--font-mono);
}
.cyber-table tr:hover { background: rgba(58, 134, 255, 0.1); }
.cyber-table tr.active-subnet-row { background: rgba(58, 134, 255, 0.18); border-left: 4px solid var(--accent-cyan); }

.badge-tag {
    background: rgba(58, 134, 255, 0.2);
    border: 1px solid rgba(58, 134, 255, 0.4);
    color: #bfdbfe;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-xs);
    font-size: 0.82rem;
    font-weight: 700;
}

/* University Guide & Formulas */
.guide-formula-card {
    background: rgba(13, 17, 26, 0.7);
    border-right: 5px solid var(--accent-cyan);
    border-radius: var(--radius-md);
    padding: 1.4rem;
    margin-bottom: 1.4rem;
}
html[dir="ltr"] .guide-formula-card {
    border-right: none;
    border-left: 5px solid var(--accent-cyan);
}
.guide-formula-card h3 { font-size: 1.15rem; color: var(--accent-cyan); margin-bottom: 0.5rem; }
.guide-formula-card p { color: #cbd5e1; font-size: 0.98rem; line-height: 1.8; }
.formula-highlight {
    font-family: var(--font-mono);
    background: rgba(2, 6, 23, 0.85);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    display: inline-block;
    color: var(--accent-gold);
    margin: 0.5rem 0;
    border: 1px solid rgba(255, 183, 3, 0.35);
    font-weight: 700;
}

/* Academic Certificate Frame (Smart Kurds Plus Edition) */
.cert-preview-wrapper {
    background: #020617;
    padding: 2.8rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    box-shadow: 0 0 60px rgba(0,0,0,0.85);
    display: flex;
    justify-content: center;
}

.academic-certificate-frame {
    max-width: 950px;
    width: 100%;
    background: radial-gradient(circle at center, #0e1526 0%, #060b14 100%);
    border: 5px double #d4af37;
    box-shadow: 0 0 45px rgba(212, 175, 55, 0.28);
    padding: 4rem 3rem;
    text-align: center;
    position: relative;
    border-radius: 6px;
}

.cert-corner-ornament {
    position: absolute;
    width: 45px;
    height: 45px;
    border: 3px solid #d4af37;
}
.cert-corner-ornament.top-left { top: 12px; left: 12px; border-right: none; border-bottom: none; }
.cert-corner-ornament.top-right { top: 12px; right: 12px; border-left: none; border-bottom: none; }
.cert-corner-ornament.bottom-left { bottom: 12px; left: 12px; border-right: none; border-top: none; }
.cert-corner-ornament.bottom-right { bottom: 12px; right: 12px; border-left: none; border-top: none; }

.cert-emblem { font-size: 3.5rem; margin-bottom: 0.6rem; }
.cert-watermark-seal {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-20deg);
    font-size: 2.5rem;
    font-weight: 900;
    color: rgba(212, 175, 55, 0.06);
    border: 4px dashed rgba(212, 175, 55, 0.1);
    padding: 0.8rem 2.2rem;
    border-radius: var(--radius-md);
    pointer-events: none;
    white-space: nowrap;
    letter-spacing: 3px;
    user-select: none;
}
.cert-main-title {
    font-size: 2.4rem;
    font-weight: 900;
    color: #f6e05e;
    letter-spacing: 1px;
    text-shadow: 0 0 25px rgba(246, 224, 94, 0.45);
    margin-bottom: 0.6rem;
}
.cert-sub-text { font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 1.8rem; }
.cert-student-name {
    font-size: 2.6rem;
    font-weight: 900;
    color: var(--accent-cyan);
    padding: 0.6rem 2.4rem;
    display: inline-block;
    border-bottom: 2px solid var(--accent-cyan);
    margin-bottom: 1.8rem;
    min-width: 340px;
}
.cert-statement { font-size: 1.2rem; color: #e2e8f0; line-height: 1.9; max-width: 760px; margin: 0 auto 2.8rem; }
.cert-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 1px solid rgba(212, 175, 55, 0.35);
    padding-top: 1.8rem;
    margin-top: 2.2rem;
    flex-wrap: wrap;
    gap: 1.8rem;
}
.cert-signature-block { text-align: center; }
.cert-sig-line { width: 200px; height: 1px; background: #cbd5e1; margin: 0 auto 0.5rem; }
.cert-sig-title { font-size: 0.88rem; color: var(--text-secondary); }

/* Toast */
.game-toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: rgba(13, 17, 26, 0.96);
    border: 1px solid var(--accent-cyan);
    box-shadow: 0 0 30px var(--shadow-glow);
    padding: 0.9rem 1.8rem;
    border-radius: var(--radius-full);
    font-size: 1rem;
    font-weight: 800;
    color: #ffffff;
    z-index: 3000;
    transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    pointer-events: none;
}
.game-toast.show { transform: translateX(-50%) translateY(0); }

/* ==========================================================
   ✦ SMART KURDS PLUS - SETTINGS DRAWER & FLOATING CONTROLS ✦
   ========================================================== */
.floating-settings-btn {
    position: fixed;
    bottom: 25px;
    z-index: 1400;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-glow);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5), var(--shadow-glow);
    transition: var(--transition);
    font-size: 1.25rem;
}
html[dir="rtl"] .floating-settings-btn {
    left: 25px;
    right: auto;
}
html[dir="ltr"] .floating-settings-btn {
    right: 25px;
    left: auto;
}
.floating-settings-btn:hover {
    transform: rotate(60deg) scale(1.1);
    background: var(--accent-cyan);
    color: #000;
}

/* Settings Drawer & Overlay */
.settings-overlay {
    position: fixed;
    inset: 0;
    background: rgba(4, 6, 10, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 2500;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
}
.settings-overlay.open {
    opacity: 1;
    pointer-events: auto;
}

.settings-drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    width: 390px;
    max-width: 90vw;
    background: rgba(13, 17, 26, 0.96);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border-left: 1px solid var(--border-glow);
    z-index: 2600;
    display: flex;
    flex-direction: column;
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.8), var(--shadow-glow);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
html[dir="rtl"] .settings-drawer {
    left: 0;
    right: auto;
    border-right: 1px solid var(--border-glow);
    border-left: none;
    transform: translateX(-100%);
}
html[dir="ltr"] .settings-drawer {
    right: 0;
    left: auto;
    border-left: 1px solid var(--border-glow);
    border-right: none;
    transform: translateX(100%);
}
.settings-drawer.open {
    transform: translateX(0) !important;
}

.settings-drawer-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.settings-drawer-title {
    display: flex;
    align-items: center;
    gap: 0.85rem;
}

.settings-title-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: rgba(0, 245, 212, 0.15);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    border: 1px solid var(--border-glow);
}

.settings-drawer-title h3 {
    font-size: 1.15rem;
    font-weight: 800;
    color: #fff;
}

.settings-subtitle {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: block;
}

.settings-close-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition: var(--transition);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
}
.settings-close-btn:hover {
    color: var(--accent-cyan);
    transform: scale(1.15);
}

.settings-drawer-body {
    padding: 1.5rem;
    overflow-y: auto;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
}

.settings-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.settings-group-label {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--accent-cyan);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

/* Language Switch Grid */
.lang-switch-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
}

.lang-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    position: relative;
    color: var(--text-primary);
    text-align: inherit;
}

.lang-card:hover {
    border-color: var(--accent-cyan);
    background: rgba(58, 134, 255, 0.08);
}

.lang-card.active {
    border-color: var(--accent-cyan);
    background: rgba(58, 134, 255, 0.16);
    box-shadow: 0 0 15px rgba(58, 134, 255, 0.25);
}

.lang-flag {
    font-size: 1.4rem;
}

.lang-info {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
}

.lang-info strong {
    font-size: 0.88rem;
}

.lang-info span {
    font-size: 0.7rem;
    color: var(--text-muted);
}

/* Font Grid */
.font-switch-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
}

.font-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.85rem;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-primary);
}

.font-card:hover {
    border-color: var(--accent-cyan);
    background: rgba(58, 134, 255, 0.08);
}

.font-card.active {
    border-color: var(--accent-cyan);
    background: rgba(58, 134, 255, 0.16);
    color: var(--accent-cyan);
    font-weight: 700;
}

.font-card span {
    font-size: 0.9rem;
}

.font-card small {
    font-size: 0.72rem;
    color: var(--text-muted);
}

/* Font Size Segmented Control */
.size-switch-group {
    display: flex;
    background: rgba(7, 9, 14, 0.7);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.25rem;
    gap: 0.25rem;
}

.size-btn {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.45rem 0.2rem;
    border-radius: 6px;
    cursor: pointer;
    transition: var(--transition);
}

.size-btn:hover {
    color: #fff;
}

.size-btn.active {
    background: var(--accent-cyan);
    color: #000;
    box-shadow: 0 0 10px rgba(58, 134, 255, 0.4);
}

/* Accent Palette Swatches */
.accent-palette-grid {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
}

.color-swatch {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--c);
    border: 2px solid transparent;
    cursor: pointer;
    transition: var(--transition);
    position: relative;
    box-shadow: 0 0 10px var(--c);
}

.color-swatch:hover {
    transform: scale(1.18);
}

.color-swatch.active {
    border-color: #fff;
    transform: scale(1.15);
    box-shadow: 0 0 18px var(--c);
}

.color-swatch.active::after {
    content: '✓';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    font-size: 0.85rem;
    font-weight: 900;
}

/* Theme Cards */
.theme-switch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(105px, 1fr));
    gap: 0.6rem;
}

.theme-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.5rem;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    text-align: center;
}

.theme-card:hover {
    border-color: var(--accent-cyan);
}

.theme-card.active {
    border-color: var(--accent-cyan);
    background: rgba(58, 134, 255, 0.12);
    color: #fff;
}

.theme-preview {
    width: 100%;
    height: 26px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}
.dark-preview { background: linear-gradient(135deg, #07090e, #3a86ff); }
.cyber-preview { background: linear-gradient(135deg, #05050a, #ff007f); }
.emerald-preview { background: linear-gradient(135deg, #03120e, #10b981); }
.sapphire-preview { background: linear-gradient(135deg, #040d1a, #3a86ff); }
.amethyst-preview { background: linear-gradient(135deg, #0d0617, #8b5cf6); }

.settings-drawer-footer {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--border-color);
}

.btn-reset-settings {
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}
.btn-reset-settings:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: #ef4444;
    color: #ef4444;
}

/* ==========================================================
   ✦ FOOTER (SMART KURDS PLUS SIGNATURE) ✦
   ========================================================== */
.app-footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 4.5rem 2rem 2.5rem 2rem;
    margin-top: 5rem;
    font-family: var(--active-font), inherit;
    position: relative;
    z-index: 10;
}

.footer-grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3.5rem;
    margin-bottom: 3rem;
}

@media (max-width: 900px) {
    .footer-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
    }
}

.footer-brand p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.8;
    margin-top: 1rem;
    max-width: 480px;
}

.footer-title {
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
}

.footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0;
}

.footer-links a, .footer-links button {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: var(--transition);
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
    text-align: inherit;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.footer-links a:hover, .footer-links button:hover {
    color: var(--accent-cyan);
    transform: translateX(-4px);
}

html[dir="ltr"] .footer-links a:hover, html[dir="ltr"] .footer-links button:hover {
    transform: translateX(4px);
}

.social-icons {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
}

.social-icon {
    width: 40px;
    height: 40px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition);
}

.social-icon:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    box-shadow: 0 0 15px rgba(58, 134, 255, 0.35);
    transform: translateY(-2px);
}

.footer-bottom {
    max-width: 1280px;
    margin: 0 auto;
    border-top: 1px solid var(--border-color);
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.2rem;
    color: var(--text-muted);
    font-size: 0.88rem;
}

.footer-bottom a {
    color: var(--text-muted);
    text-decoration: none;
    transition: var(--transition);
}

.footer-bottom a:hover {
    color: var(--accent-cyan);
}

/* Print Stylesheet */
@media print {
    body { background: white !important; color: black !important; }
    .app-header, .floating-settings-btn, .settings-drawer, .settings-overlay, #bgCanvas, #certControlsArea {
        display: none !important;
    }
    .app-view { display: none !important; }
    #viewCertificate { display: block !important; }
    .cert-preview-wrapper { background: white !important; padding: 0 !important; box-shadow: none !important; border: none !important; }
    .academic-certificate-frame { background: white !important; color: black !important; border: 3px double #333 !important; box-shadow: none !important; }
    .cert-main-title { color: #1e293b !important; }
    .cert-student-name { color: #0369a1 !important; }
    .cert-statement { color: #334155 !important; }
}

/* Responsive */
@media (max-width: 900px) {
    .app-header {
        flex-direction: column;
        align-items: stretch;
        gap: 1rem;
        padding: 1rem;
    }
    .nav-links {
        overflow-x: auto;
        width: 100%;
        scrollbar-width: none;
    }
    .calc-inputs-bar { grid-template-columns: 1fr; }
    .speed-options-grid { grid-template-columns: 1fr; }
    .speed-ip-display { font-size: 1.7rem; }
}
